{
    "manifest_version": 3,
    "name": "WDMVE - When Does My Video End?",
    "version": "0.1.0",
    "description": "Ever paused a video just to wonder, 'When does this thing end?' WDMVE shows you the exact local time your video will finish—so you’ll know if you can squeeze in one more episode before midnight (or your next Zoom call).",

    "icons": {
        "16": "images/default-16.png",
        "32": "images/default-32.png",
        "48": "images/default-48.png",
        "128": "images/default-128.png"
    },

    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "images/default-16.png",
            "32": "images/default-32.png",
            "48": "images/default-48.png",
            "128": "images/default-128.png"
        }
    },

    "content_scripts": [
        {
            "matches": ["*://*.youtube.com/*", "*://*.netflix.com/*"],
            "js": ["scripts/content.js"],
            "run_at": "document_idle"
        }
    ],

    "web_accessible_resources": [
        {
            "resources": ["scripts/inject-api.js", "scripts/yt-helper.js"],
            "matches": ["*://*.youtube.com/*"]
        }
    ],

    "background": {
        "service_worker": "background.js"
    },

    "permissions": ["tabs", "scripting", "storage"],

    "options_page": "options/options.html"
}
